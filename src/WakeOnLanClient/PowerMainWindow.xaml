<Window x:Class="WakeOnLanClient.PowerMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="局域网开关机"
        Height="520"
        Width="560"
        MinHeight="440"
        MinWidth="480"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="目标电脑开关机"
               FontSize="18"
               FontWeight="SemiBold"
               Margin="0,0,0,16" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="IP 地址" VerticalAlignment="Center" Margin="0,0,0,10" />
      <TextBox x:Name="TxtIpAddress"
               Grid.Row="0"
               Grid.Column="1"
               Height="28"
               Margin="0,0,0,10"
               VerticalContentAlignment="Center" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="MAC 地址" VerticalAlignment="Center" Margin="0,0,0,10" />
      <TextBox x:Name="TxtMacAddress"
               Grid.Row="1"
               Grid.Column="1"
               Height="28"
               Margin="0,0,0,10"
               VerticalContentAlignment="Center"
               ToolTip="开机时必填，支持 AA:BB:CC:DD:EE:FF 或 AABBCCDDEEFF" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="用户名" VerticalAlignment="Center" Margin="0,0,0,10" />
      <TextBox x:Name="TxtUserName"
               Grid.Row="2"
               Grid.Column="1"
               Height="28"
               Margin="0,0,0,10"
               VerticalContentAlignment="Center"
               ToolTip="关机时使用，例如 .\Administrator 或 DOMAIN\admin" />

      <TextBlock Grid.Row="3" Grid.Column="0" Text="密码" VerticalAlignment="Center" Margin="0,0,0,10" />
      <PasswordBox x:Name="TxtPassword"
                   Grid.Row="3"
                   Grid.Column="1"
                   Height="28"
                   Margin="0,0,0,10"
                   VerticalContentAlignment="Center" />

      <TextBlock Grid.Row="4" Grid.Column="0" Text="电源动作" VerticalAlignment="Center" Margin="0,0,0,12" />
      <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
        <RadioButton x:Name="RdoPowerOn"
                     Content="开机"
                     IsChecked="True"
                     Margin="0,0,20,0"
                     Checked="PowerAction_Checked" />
        <RadioButton x:Name="RdoPowerOff"
                     Content="关机"
                     Checked="PowerAction_Checked" />
      </StackPanel>

      <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
        <Button x:Name="BtnExecute"
                Content="执行"
                Width="100"
                Height="32"
                Click="BtnExecute_Click" />
        <TextBlock x:Name="TxtStatus"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"
                   Foreground="#555555"
                   Text="就绪" />
      </StackPanel>
    </Grid>

    <GroupBox Grid.Row="2" Header="执行日志" Padding="8">
      <TextBox x:Name="TxtLog"
               IsReadOnly="True"
               IsUndoEnabled="False"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               TextWrapping="Wrap"
               AcceptsReturn="True"
               FontFamily="Consolas"
               FontSize="12"
               Background="#101418"
               Foreground="#D7E2EA"
               BorderThickness="0" />
    </GroupBox>
  </Grid>
</Window>
